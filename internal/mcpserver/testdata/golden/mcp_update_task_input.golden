{
  "additionalProperties": false,
  "properties": {
    "expected_etag": {
      "description": "etag from an earlier read of the task; if omitted the current version is used",
      "type": "string"
    },
    "id": {
      "description": "task id",
      "type": "integer"
    },
    "notes": {
      "description": "new notes; empty string clears them",
      "type": "string"
    },
    "priority": {
      "description": "priority H, M or L, or null to clear",
      "enum": [
        "H",
        "M",
        "L",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "description": "project name, or null to clear",
      "type": [
        "string",
        "null"
      ]
    },
    "tags_add": {
      "description": "tags to add",
      "items": {
        "type": "string"
      },
      "type": [
        "null",
        "array"
      ]
    },
    "tags_remove": {
      "description": "tags to remove",
      "items": {
        "type": "string"
      },
      "type": [
        "null",
        "array"
      ]
    },
    "title": {
      "description": "new title",
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "type": "object"
}

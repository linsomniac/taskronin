{
  "additionalProperties": false,
  "properties": {
    "expected_etag": {
      "description": "etag from an earlier read of the task; if omitted the current version is used",
      "type": "string"
    },
    "id": {
      "description": "task id",
      "type": "integer"
    },
    "until": {
      "description": "hide the task until this date (today, tomorrow, a weekday, +3d, +2w or YYYY-MM-DD, optionally with HH:MM), or none to clear the deferral",
      "type": "string"
    }
  },
  "required": [
    "id",
    "until"
  ],
  "type": "object"
}

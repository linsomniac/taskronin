{
  "additionalProperties": false,
  "properties": {
    "expected_etag": {
      "description": "etag from an earlier read of the task; if omitted the current version is used",
      "type": "string"
    },
    "how": {
      "description": "keep, top, bottom, before or after",
      "enum": [
        "keep",
        "top",
        "bottom",
        "before",
        "after"
      ],
      "type": "string"
    },
    "id": {
      "description": "task id",
      "type": "integer"
    },
    "ref_id": {
      "description": "reference task id, required for before and after",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "how"
  ],
  "type": "object"
}
